# 切勿提交真实凭据。请将此文件复制为 .env，并在本地填写配置。
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-max-2026-05-20
OPENAI_EMBEDDING_MODEL=text-embedding-v4

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-me
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=enterprise-ai-assistant

POSTGRES_DSN=postgresql://enterprise:enterprise@localhost:5432/enterprise_ai
REDIS_URL=redis://localhost:6379/0
MILVUS_URI=http://localhost:19530
APP_ENV=development

# 身份认证。生产环境必须显式配置 JWT_SECRET（HS256 要求至少 32 字节），
# 开发环境留空时进程启动会生成一次性密钥。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-32-byte-or-longer-random-secret
ACCESS_TOKEN_TTL_MINUTES=60
# 仅供本地联调：开启后暴露 /api/v1/auth/dev-token 用于签发测试令牌。
DEV_LOGIN_ENABLED=true

# 可观测性。单价用于把 token 折算成成本指标，按所用模型的实际价格填写。
LLM_INPUT_COST_PER_1K_USD=0
LLM_OUTPUT_COST_PER_1K_USD=0
# 单会话累计 token 上限，0 表示不限制。
CONVERSATION_TOKEN_BUDGET=0
CORS_ORIGINS=["http://localhost:5173"]

# 断线恢复。continue 表示 SSE 断开后执行继续跑完，客户端重连仍能拿到结果。
RUN_ON_DISCONNECT=continue
# 每次运行保留的事件条数，供重连回放；超出窗口的游标会收到 gap 事件。
RUN_EVENT_BUFFER_SIZE=512
# 运行结束后事件缓冲的保留时长（秒）。
RUN_RETENTION_SECONDS=300
# SSE 空闲心跳间隔（秒），需小于反向代理的读超时。
SSE_HEARTBEAT_SECONDS=15
