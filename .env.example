# 切勿提交真实凭据。请将此文件复制为 .env，并在本地填写配置。
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-max-2026-05-20
OPENAI_EMBEDDING_MODEL=text-embedding-v4
# 混合思考模型是否先推理再作答，以 enable_thinking / thinking_budget 请求参数下发。
# 不限预算时一次调用常要十几秒。接 OpenAI 官方等不认这些参数的服务时把开关留空，不下发。
# Supervisor 开关思考评测结果一样，关掉；领域 Agent 关掉会在缺字段时直接提交写操作。
SUPERVISOR_ENABLE_THINKING=false
DOMAIN_ENABLE_THINKING=true
# 领域 Agent 推理 token 上限，0 表示不限（不要用：实测一次决策推理了 622 秒）。
# qwen3.7-flash 上预算 500、温度 0 连跑三轮有两轮缺字段直接提交，4000、温度 0.6 三轮全过但慢一倍。
DOMAIN_THINKING_BUDGET=2000
# 采样温度，按角色配。领域 Agent 开思考，用 Qwen3 推荐的 0.6，温度 0 容易在推理里陷入重复；
# Supervisor 关思考、做分类和结构化输出，保持 0 让判断稳定。
SUPERVISOR_TEMPERATURE=0
DOMAIN_TEMPERATURE=0.6

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-me
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=enterprise-ai-assistant

POSTGRES_DSN=postgresql://enterprise:enterprise@localhost:5432/enterprise_ai
REDIS_URL=redis://localhost:6379/0
# 本地文件路径走 Milvus Lite（同一文件只能一个进程打开）；接 Milvus 服务时填 http://host:19530。
POLICY_VECTOR_URI=./data/milvus.db
APP_ENV=development

# 身份认证。生产环境必须显式配置 JWT_SECRET（HS256 要求至少 32 字节），
# 开发环境留空时进程启动会生成一次性密钥。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-32-byte-or-longer-random-secret
# 令牌有效期（分钟）。超过 1440 只允许在 APP_ENV=development：访问令牌没有吊销机制，
# 签出去在过期前作废不了（除非更换 JWT_SECRET，那会踢掉所有人），
# 泄漏后的暴露窗口就等于这个值。演示环境可以填一个大到形同永久的数。
ACCESS_TOKEN_TTL_MINUTES=60
# 仅供本地联调：开启后暴露 /api/v1/auth/dev-token 用于签发测试令牌。
DEV_LOGIN_ENABLED=true
# 演示用的名字注册/登录（/api/v1/auth/register、/auth/login）。没有任何凭据，
# 输入他人的名字即可读到对方的会话与记忆，只允许在 APP_ENV=development 下开启。
DEMO_LOGIN_ENABLED=true

# 可观测性。单价用于把 token 折算成成本指标，按所用模型的实际价格填写。
LLM_INPUT_COST_PER_1K_USD=0
LLM_OUTPUT_COST_PER_1K_USD=0
# 单会话累计 token 上限，0 表示不限制。
CONVERSATION_TOKEN_BUDGET=0
# 单个来源 IP 在窗口内的累计 token 上限，0 表示不限制；窗口从第一笔用量起算，到期清零。
# 部署在反向代理后面时要给 uvicorn 配 --proxy-headers 和 FORWARDED_ALLOW_IPS，否则所有人共用代理的 IP。
IP_TOKEN_BUDGET=0
IP_BUDGET_TTL_HOURS=24
# 领域 Agent 读的最近会话原文条数，0 表示不给原文。调大会给它更多从旧事项里串字段的材料。
DOMAIN_CONTEXT_MESSAGES=10
CORS_ORIGINS=["http://localhost:5173"]

# 断线恢复。continue 表示 SSE 断开后执行继续跑完，客户端重连仍能拿到结果。
RUN_ON_DISCONNECT=continue
# 每次运行保留的事件条数，供重连回放；超出窗口的游标会收到 gap 事件。
RUN_EVENT_BUFFER_SIZE=512
# 运行结束后事件缓冲的保留时长（秒）。
RUN_RETENTION_SECONDS=300
# SSE 空闲心跳间隔（秒），需小于反向代理的读超时。
SSE_HEARTBEAT_SECONDS=15

# 跨会话长期记忆。默认关闭：记错一条画像会污染该用户后续所有会话，
# 打开前请确认已有删除入口（DELETE /api/v1/memories/{id}）和灰度范围。
MEMORY_ENABLED=false
# 单轮注入领域子图的画像条数上限。
MEMORY_RECALL_LIMIT=20
# 从 workflow_actions 派生的近期单据条数，用于关联 travel_reference 这类字段。
MEMORY_RECENT_ACTION_LIMIT=5
